# Vorlage: nach .env kopieren und anpassen.

# Version des Images (z. B. 0.1.0); leer = latest
STUNDEN_VERSION=
# Port auf dem Heimserver
STUNDEN_PORT=3002
# Zeitzone – bestimmt, wann "heute" ist
TZ=Europe/Berlin

# Hinter HTTPS (Reverse Proxy) auf true setzen
COOKIE_SECURE=false
# Hinter einem Reverse Proxy: Anzahl der Proxys, z. B. 1
TRUST_PROXY=false
# Optional: eigener Schlüssel für das Session-Cookie (sonst automatisch im Datenordner)
SESSION_SECRET=
